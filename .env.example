# =============================================
# 유튜브 MP3 추출기 환경 설정 (복사해서 .env로 사용)
# cp .env.example .env
# =============================================

# ---------- Gemini (메타데이터 보정) ----------
# Gemini API 키 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Gemini 웹 자동화 (로그인된 브라우저 사용 시)
GEMINI_CHAT_URL=https://gemini.google.com/app

# ---------- Chrome 브라우저 연동 (선택) ----------
# 이미 실행 중인 크롬의 원격 디버깅 포트 (예: 9222)
CHROME_DEBUGGING_PORT=
# 사용자 크롬 데이터 경로 (로그인 세션 유지, 선택)
CHROME_USER_DATA=
CHROME_PROFILE=Default

# ---------- 음악 자동 식별 (오디오 핑거프린팅) ----------
# ACRCloud (https://console.acrcloud.com - 무료 티어)
ACRCLOUD_HOST=identify.ap-southeast-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# AudD (https://audd.io - 무료 티어 월 200회)
AUDD_API_TOKEN=